# Copy to .env.local and fill from Firebase console > Project settings > Your apps > Web app.
# If any required value is missing, the app automatically uses the local adapter
# (localStorage + storage events + BroadcastChannel) instead of Firestore.
# Vite exposes VITE_* values to the browser. The web API key is not a secret,
# but Firestore Security Rules are what actually protect the database.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
