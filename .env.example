# Optional. Copy to .env and fill from Firebase console > Project settings > Your apps > Web app.
# If these are absent, the app automatically uses the local (same-device, cross-window) adapter.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
